{
	"menu": [
		{
			"id": "ReportsMenu",
			"label": "Reports",
			"icon": "ChartBoxOutline",
			"route": "Reports",
			"section": "settings",
			"order": 95
		}
	],
	"pages": [
		{
			"id": "Reports",
			"_note": "ADR-112 / ADR-114 Decision 3. All three are declarative type:dashboard pages over filinq's own register — no bespoke component and no per-app controller. Nothing moves here: filinq had no report surface at all before this, so these are new readings rather than relocated menu entries.",
			"route": "/reports",
			"type": "reports",
			"title": "Reports",
			"config": {
				"description": "Pick a report to open it.",
				"categories": {
					"signing": "Signing",
					"documents": "Documents"
				},
				"cards": [
					{
						"id": "SigningReport",
						"label": "Signing",
						"description": "Where each signing request stands, and what signers did with it.",
						"icon": "SignatureFreehand",
						"category": "signing",
						"route": "SigningReport"
					},
					{
						"id": "AnonymizationReport",
						"label": "Anonymisation",
						"description": "What is being anonymised, from where, and what failed.",
						"icon": "EyeOffOutline",
						"category": "documents",
						"route": "AnonymizationReport"
					},
					{
						"id": "ProducedDocumentsReport",
						"label": "Documents produced",
						"description": "What the templates generated, in which format, and what went out as correspondence.",
						"icon": "FileDocumentMultipleOutline",
						"category": "documents",
						"route": "ProducedDocumentsReport"
					}
				]
			}
		},
		{
			"id": "SigningReport",
			"route": "/reports/signing",
			"type": "dashboard",
			"title": "Signing",
			"_note": "The status enums here are UPPERCASE on signingRequest and signerRecord (DRAFT/PENDING/…), lowercase on anonymizationBatch and generatedDocument. Every filter is scalar equality, the only kind OpenRegister's aggregation endpoint can evaluate, and it does not fold case: a filter of \"completed\" against COMPLETED counts zero and reports it as zero.",
			"config": {
				"widgets": [
					{
						"id": "signing-open",
						"title": "Awaiting signature",
						"type": "stat",
						"content": {
							"label": "Awaiting signature",
							"icon": "SignatureFreehand",
							"route": {
								"name": "SigningRequests"
							},
							"format": {
								"style": "decimal",
								"decimals": 0
							},
							"source": {
								"register": "filinq",
								"schema": "signingRequest",
								"metric": "count",
								"filter": {
									"status": "PENDING"
								}
							}
						}
					},
					{
						"id": "signing-in-progress",
						"title": "Part-signed",
						"type": "stat",
						"content": {
							"label": "Part-signed",
							"icon": "AccountEdit",
							"route": {
								"name": "SigningRequests"
							},
							"format": {
								"style": "decimal",
								"decimals": 0
							},
							"source": {
								"register": "filinq",
								"schema": "signingRequest",
								"metric": "count",
								"filter": {
									"status": "IN_PROGRESS"
								}
							}
						}
					},
					{
						"id": "signing-completed",
						"title": "Completed",
						"type": "stat",
						"content": {
							"label": "Completed",
							"icon": "FileDocumentCheck",
							"route": {
								"name": "SigningRequests"
							},
							"format": {
								"style": "decimal",
								"decimals": 0
							},
							"source": {
								"register": "filinq",
								"schema": "signingRequest",
								"metric": "count",
								"filter": {
									"status": "COMPLETED"
								}
							}
						}
					},
					{
						"id": "signing-by-status",
						"title": "By status",
						"type": "chart",
						"content": {
							"chartKind": "donut",
							"legendPosition": "bottom",
							"emptyLabel": "No signing requests yet",
							"dataSource": {
								"register": "filinq",
								"schema": "signingRequest",
								"aggregate": {
									"groupBy": "status",
									"metric": "count"
								}
							}
						}
					},
					{
						"id": "signing-by-level",
						"title": "By assurance level",
						"type": "chart",
						"content": {
							"chartKind": "donut",
							"legendPosition": "bottom",
							"emptyLabel": "No signing requests yet",
							"dataSource": {
								"register": "filinq",
								"schema": "signingRequest",
								"aggregate": {
									"groupBy": "signatureLevel",
									"metric": "count"
								}
							}
						}
					},
					{
						"id": "signers-by-status",
						"title": "What signers did",
						"type": "chart",
						"content": {
							"chartKind": "donut",
							"legendPosition": "bottom",
							"emptyLabel": "Nobody has been asked to sign yet",
							"dataSource": {
								"register": "filinq",
								"schema": "signerRecord",
								"aggregate": {
									"groupBy": "status",
									"metric": "count"
								}
							}
						}
					},
					{
						"id": "signing-audit",
						"title": "Most recent activity",
						"type": "object-table",
						"content": {
							"register": "filinq",
							"schema": "signingAuditEntry",
							"filter": {},
							"sort": {
								"field": "timestamp",
								"dir": "desc"
							},
							"limit": 8,
							"hideHeader": true,
							"emptyText": "Nothing has happened yet",
							"viewAllRoute": {
								"name": "SigningRequests"
							},
							"viewAllLabel": "View all signing requests",
							"columns": [
								{
									"key": "timestamp",
									"label": "When"
								},
								{
									"key": "action",
									"label": "Action"
								},
								{
									"key": "actorDisplayName",
									"label": "Who"
								}
							]
						}
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "signing-open",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": "2",
						"widgetId": "signing-in-progress",
						"gridX": 4,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": "3",
						"widgetId": "signing-completed",
						"gridX": 8,
						"gridY": 0,
						"gridWidth": 4,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": "4",
						"widgetId": "signing-by-status",
						"gridX": 0,
						"gridY": 2,
						"gridWidth": 4,
						"gridHeight": 4,
						"showTitle": true
					},
					{
						"id": "5",
						"widgetId": "signing-by-level",
						"gridX": 4,
						"gridY": 2,
						"gridWidth": 4,
						"gridHeight": 4,
						"showTitle": true
					},
					{
						"id": "6",
						"widgetId": "signers-by-status",
						"gridX": 8,
						"gridY": 2,
						"gridWidth": 4,
						"gridHeight": 4,
						"showTitle": true
					},
					{
						"id": "7",
						"widgetId": "signing-audit",
						"gridX": 0,
						"gridY": 6,
						"gridWidth": 12,
						"gridHeight": 4,
						"showTitle": true
					}
				]
			}
		},
