			"route": "/reports/documents",
			"type": "dashboard",
			"title": "Documents produced",
			"_note": "Two schemas, deliberately on one page: a generatedDocument is a template rendered, a correspondence is one sent to somebody. Splitting them would make the reader open two pages to answer one question.",
			"config": {
				"widgets": [
					{
						"id": "docs-generated",
