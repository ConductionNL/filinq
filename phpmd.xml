<?xml version="1.0"?>
<ruleset name="docudesk"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 http://pmd.sourceforge.net/ruleset_xml_schema.xsd">
    <description>docudesk — Conduction PHPMD ruleset (single source: conduction/hydra-gates).</description>

    <!-- Deviations from the central ruleset go BELOW this line, each with a
         reason. Everything else comes from conduction/hydra-gates. -->
    <rule ref="vendor/conduction/hydra-gates/quality-config/phpmd.xml">
        <exclude name="ShortVariable"/>
    </rule>

    <!-- ShortVariable: the central allowlist plus this app's geometry names.

         Docudesk does page/PDF layout and colour maths, where x, y, h, s, m, d,
         g, x1, y1, x2, y2, cx, cy, px, py and the rf/gf/bf channel factors are
         the conventional names in every reference implementation. The rule is
         otherwise unchanged, including `minimum`; only the allowlist is longer
         than the central one, and it is a strict superset of it. -->
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <property name="minimum" value="3" />
            <property name="exceptions" value="id,db,qb,op,ui,io,gc,tz,pk,fk,to,ch,a,b,l,v,c,t,r,f,n,k,e,x,y,h,s,m,d,g,x1,y1,x2,y2,cx,cy,px,py,rf,gf,bf" />
        </properties>
    </rule>
</ruleset>
