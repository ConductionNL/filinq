{
    "a frame name with regex characters": [
        {
            "PackagePartIo::readPart": {
                "packageBytes": "pkg",
                "part": "content.xml"
            }
        },
        {
            "PackagePartIo::writePart": {
                "packageBytes": "pkg",
                "part": "content.xml",
                "xml": "<office:document-content><office:presentation><draw:page draw:name=\"Intro\"><draw:frame draw:name=\"T.(1)\"><draw:text-box><text:p>ok</text:p></draw:text-box></draw:frame></draw:page></office:presentation></office:document-content>"
            }
        },
        {
            "result": "package-bytes"
        }
    ],
    "a notes frame is not on the slide": [
        {
            "PackagePartIo::readPart": {
                "packageBytes": "pkg",
                "part": "content.xml"
            }
        },
