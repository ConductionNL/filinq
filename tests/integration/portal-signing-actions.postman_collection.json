{
  "info": {
    "name": "Filinq portal signing receiver (fail-closed contract)",
    "description": "The portal signing receiver (portal-signing-actions) refuses every call that does not carry a verified portaliq assertion. These cases need no secret and no seeded signer, so CI runs them on every PR. The happy path needs portaliq's A6 signerEmail forward and is a live check.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/index.php",
      "description": "Nextcloud entry point, as in filinq-api-negative.postman_collection.json."
    }
  ],
  "item": [
    {
      "name": "Portal signing receiver",
      "item": [
        {
          "name": "POST /api/portal/signing/sign - 401 without an assertion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "OCS-APIREQUEST",
                "value": "true"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/apps/filinq/api/portal/signing/sign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "apps",
                "filinq",
                "api",
                "portal",
                "signing",
                "sign"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"signingRequestId\": \"00000000-0000-4000-8000-000000000000\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// portal-signing-actions REQ-DDPSA-002/003: the receiver derives the signer only from a",
                  "// verified HS256 assertion. Anything else fails closed with a JSON 401 before any",
                  "// signing request is looked up, so it can never sign, decline or show a document.",
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('401 is a JSON error, not the SPA HTML fallback', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.expect(pm.response.json().error).to.equal('unauthorized');",
                  "});"
                ]
              }
            }
          ]
        },
