{
	"info": {
		"name": "Filinq batch anonymisation output folder layout",
		"description": "anonymisation-batch-output-folder-layout task 11. Three text files in one folder go through a folder batch: extract, anonymise (format kept). The anonymised copies land in the folder's anonymised/ subfolder under their own names, and no _anonymized file is left beside the sources. It needs a live instance with entity detection, so it sits in tests/integration/live/, outside the flat glob the CI Newman job runs. Run it with: npx newman run tests/integration/live/anonymisation-output-layout.postman_collection.json --env-var baseUrl=$BASE_URL --env-var adminUser=$ADMIN_USER --env-var adminPass=$ADMIN_PASS",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "MKCOL the batch folder",
			"request": {
				"method": "MKCOL",
				"header": [
					{
						"key": "OCS-APIREQUEST",
						"value": "true"
					}
				],
				"auth": {
					"type": "basic",
					"basic": [
						{
							"key": "username",
							"value": "{{adminUser}}",
							"type": "string"
						},
						{
							"key": "password",
							"value": "{{adminPass}}",
							"type": "string"
						}
					]
				},
				"url": {
					"raw": "{{baseUrl}}/remote.php/dav/files/{{adminUser}}/{{layoutFolder}}"
				}
			},
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// anonymisation-batch-output-folder-layout task 11: one folder per run.",
							"pm.collectionVariables.set('layoutFolder', 'filinq-layout-' + Date.now());",
							"pm.collectionVariables.set('extractTries', '0');"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Folder created', () => pm.expect(pm.response.code).to.equal(201));"
						]
					}
				}
			]
		},
		{
			"name": "PUT verslag-a.txt",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "OCS-APIREQUEST",
						"value": "true"
					},
					{
						"key": "Content-Type",
						"value": "text/plain"
					}
				],
				"auth": {
					"type": "basic",
					"basic": [
						{
							"key": "username",
							"value": "{{adminUser}}",
							"type": "string"
						},
						{
							"key": "password",
							"value": "{{adminPass}}",
							"type": "string"
						}
					]
				},
				"url": {
					"raw": "{{baseUrl}}/remote.php/dav/files/{{adminUser}}/{{layoutFolder}}/verslag-a.txt"
				},
				"body": {
					"mode": "raw",
					"raw": "Gesprek met Jan Jansen op 3 maart. BSN 111222333. Telefoon 06-12345678."
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('verslag-a.txt uploaded', () => pm.expect(pm.response.code).to.be.oneOf([201, 204]));"
						]
					}
				}
			]
		},
