						}
					]
				},
				"url": {
					"raw": "{{baseUrl}}/remote.php/dav/files/{{adminUser}}/{{layoutFolder}}"
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Folder removed', () => pm.expect(pm.response.code).to.be.oneOf([204, 404]));"
						]
					}
				}
			]
		}
	],
