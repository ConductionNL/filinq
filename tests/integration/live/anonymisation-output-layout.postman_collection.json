			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// Extraction runs one file per call (or in the background for a folder batch):",
							"// go back to the extract step until the batch is in review, at most 30 times.",
							"const body = pm.response.json();",
							"const tries = Number(pm.collectionVariables.get('extractTries') || 0) + 1;",
							"pm.collectionVariables.set('extractTries', String(tries));",
							"if (body.complete !== true && tries < 30) {",
							"    postman.setNextRequest('POST batch/{id}/extract - next file');",
							"    return;",
							"}",
							"pm.test('Extraction completed', () => pm.expect(body.complete).to.equal(true));",
							"pm.test('Entities were found', () => pm.expect(body.entityCount).to.be.above(0));",
							"pm.collectionVariables.set('layoutEntities', JSON.stringify(body.entities));"
						]
					}
				}
			]
		},
		{
			"name": "Review: a person checks each document (deciding its uncertain findings)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// Two marks gate the write today. The review workbench's check (anonymization-review-workbench)",
							"// gates the batch and every document; a document cannot be marked there while an uncertain",
							"// finding is undecided, so a check that names undecided findings is sent again deciding them.",
							"// The redaction mark (RedactionOutputGuard, set by the folder view's 'checked' button) gates",
							"// each copy, over exactly the entities the anonymise call sends.",
							"const ids = JSON.parse(pm.collectionVariables.get('layoutFileIds') || '[]');",
							"pm.collectionVariables.set('layoutReviewFileId', String(ids[0] || 0));",
							"// The reviewer checks; the admin anonymises below, so four eyes see each document.\nconst auth = 'Basic ' + btoa(pm.variables.get('reviewerUser') + ':' + pm.variables.get('reviewerPass'));",
							"// Newman keeps the admin's Nextcloud session cookie, and Nextcloud prefers a session over the",
							"// Basic header: without clearing the jar the reviewer's calls would run as the admin.",
							"pm.cookies.jar().clear(pm.variables.get('baseUrl'), () => {",
							"\tconst check = (id, decided, retry) => pm.sendRequest({",
							"\t\turl: pm.variables.get('baseUrl') + '/index.php/apps/filinq/api/review/' + id + '/check',",
							"\t\tmethod: 'POST',",
							"\t\theader: { 'OCS-APIREQUEST': 'true', 'Content-Type': 'application/json', Authorization: auth },",
							"\t\tbody: { mode: 'raw', raw: JSON.stringify({ decided }) },",
							"\t}, (err, res) => {",
							"\t\tif (err) { console.error('check ' + id + ' failed', err); return; }",
							"\t\tconst body = res.json();",
							"\t\tif (res.code === 409 && body.reason === 'uncertain_undecided' && retry) {",
							"\t\t\tcheck(id, (body.undecidedFindings || []).map((f) => f.relationId), false);",
							"\t\t} else if (res.code >= 300) {",
							"\t\t\tconsole.error('check ' + id + ' refused', res.code, body.reason);",
							"\t\t}",
							"\t});",
							"\tids.forEach((id) => check(id, [], true));",
							"\tconst entities = JSON.parse(pm.collectionVariables.get('layoutEntities') || '[]')",
							"\t\t.filter((e) => e.included !== false)",
							"\t\t.map((e) => ({ type: e.type, value: e.value, confidence: e.highestConfidence ?? e.confidence }))",
							"\t\t.sort((a, b) => (b.value || '').length - (a.value || '').length);",
							"\tids.forEach((id) => pm.sendRequest({",
							"\t\turl: pm.variables.get('baseUrl') + '/index.php/apps/filinq/api/redaction/documents/' + id + '/checked',",
							"\t\tmethod: 'POST',",
							"\t\theader: { 'OCS-APIREQUEST': 'true', 'Content-Type': 'application/json', Authorization: auth },",
							"\t\tbody: { mode: 'raw', raw: JSON.stringify({ entities }) },",
							"\t}, (err, res) => { if (err || res.code >= 300) { console.error('redaction mark ' + id + ' refused', err || res.code); } }));",
							"});"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('The document reads as checked', () => {",
							"\tpm.expect(pm.response.code).to.equal(200);",
							"\tpm.expect(pm.response.json().checked).to.equal(true);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "OCS-APIREQUEST",
						"value": "true"
					},
					{
						"key": "Content-Type",
