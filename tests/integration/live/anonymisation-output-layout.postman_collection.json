							"const result = pm.response.json();",
							"// A batch that skipped every file still answers 200: count what was written.",
							"pm.test('All three copies were written, none skipped', () => {",
							"\tpm.expect(result.skippedFiles || [], JSON.stringify(result.skippedFiles)).to.eql([]);",
