{
	"info": {
		"name": "Filinq batch lifecycle contracts",
		"description": "Newman contracts for cancelling, resuming and reporting a folder anonymisation batch (openspec change redaction-at-scale, REQ-DDRAS-004 cooperative cancellation and REQ-DDRAS-005 idempotent resume). Setup makes a folder with one document over WebDAV and starts a folder batch; extraction runs asynchronously, so cancel and resume accept the two answers the state machine allows at that moment (202 or 409) and assert the body of each; unknown batches answer 404 and unauthenticated calls 401. Teardown cancels and removes the folder. Same auth model as filinq.postman_collection.json: explicit basic auth per request, no-auth calls against {{noAuthBase}}.\n\nSPDX-License-Identifier: EUPL-1.2\nSPDX-FileCopyrightText: 2026 Conduction B.V. <info@conduction.nl>",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "noauth"
	},
	"item": [
		{
			"name": "0. Setup",
			"item": [
				{
					"name": "make the batch folder (WebDAV MKCOL)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('folder created or already there', () => pm.expect([201, 405]).to.include(pm.response.code));"
								]
							}
						}
					],
					"request": {
						"method": "MKCOL",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/remote.php/dav/files/{{adminUser}}/{{batchFolder}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"remote.php",
								"dav",
								"files",
								"{{adminUser}}",
								"{{batchFolder}}"
							]
						},
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "{{adminUser}}",
									"type": "string"
								},
								{
									"key": "password",
									"value": "{{adminPass}}",
									"type": "string"
								}
							]
						}
					}
				},
				{
					"name": "put one document in it (WebDAV PUT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('file stored', () => pm.expect([201, 204]).to.include(pm.response.code));"
								]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "text/plain"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/remote.php/dav/files/{{adminUser}}/{{batchFolder}}/brief.txt",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"remote.php",
								"dav",
								"files",
								"{{adminUser}}",
								"{{batchFolder}}",
								"brief.txt"
							]
						},
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "{{adminUser}}",
									"type": "string"
								},
								{
									"key": "password",
									"value": "{{adminPass}}",
									"type": "string"
								}
							]
						},
						"body": {
							"mode": "raw",
							"raw": "Geachte heer Jansen, uw aanvraag van 3 maart is ontvangen."
						}
					}
				},
				{
					"name": "start a folder batch (capture batchId)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"pm.test('clean JSON, not HTML', () => pm.expect(pm.response.headers.get('Content-Type')).to.match(/application\\/(problem\\+)?json/));",
									"const b = pm.response.json();",
									"pm.test('returns a batchId', () => pm.expect(b.batchId).to.be.a('string').and.not.empty);",
									"pm.test('counts the one file', () => pm.expect(b.fileCount).to.eql(1));",
									"pm.collectionVariables.set('batchId', b.batchId);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "OCS-APIRequest",
								"value": "true"
							},
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/index.php/apps/filinq/api/anonymization/batch/folder",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"index.php",
								"apps",
								"filinq",
								"api",
								"anonymization",
								"batch",
								"folder"
							]
						},
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "{{adminUser}}",
									"type": "string"
								},
								{
									"key": "password",
									"value": "{{adminPass}}",
									"type": "string"
								}
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\"folderPath\": \"/{{batchFolder}}\"}"
						}
					}
				}
			]
		},
		{
			"name": "1. Cancel",
			"item": [
				{
					"name": "cancel the batch (202 cancelled/cancelling, or 409 when it already ended)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('202 or 409, never 500', () => pm.expect([202, 409]).to.include(pm.response.code));",
									"pm.test('clean JSON, not HTML', () => pm.expect(pm.response.headers.get('Content-Type')).to.match(/application\\/(problem\\+)?json/));",
									"const b = pm.response.json();",
									"if (pm.response.code === 202) {",
									"  pm.test('names the batch', () => pm.expect(b.batchId).to.eql(pm.collectionVariables.get('batchId')));",
									"  pm.test('is cancelled or cancelling', () => pm.expect(['cancelled', 'cancelling']).to.include(b.batchStatus));",
									"} else {",
									"  pm.test('says why it cannot be cancelled', () => pm.expect(b.error).to.be.a('string').and.not.empty);",
									"  pm.test('names the state it ended in', () => pm.expect(['completed', 'error', 'cancelled']).to.include(b.batchStatus));",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "OCS-APIRequest",
								"value": "true"
							},
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
