			"item": [
				{
					"name": "resume the cancelled batch (202 with the re-queued count, or 409 while cancelling)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('202 or 409, never 500', () => pm.expect([202, 409]).to.include(pm.response.code));",
									"pm.test('clean JSON, not HTML', () => pm.expect(pm.response.headers.get('Content-Type')).to.match(/application\\/(problem\\+)?json/));",
									"const b = pm.response.json();",
									"if (pm.response.code === 202) {",
									"  pm.test('reports how many files were re-queued', () => pm.expect(b.requeued).to.be.a('number').and.at.least(0));",
									"  pm.test('names the batch', () => pm.expect(b.batchId).to.eql(pm.collectionVariables.get('batchId')));",
									"} else {",
									"  pm.test('says only errored or cancelled batches resume', () => pm.expect(b.error).to.be.a('string').and.not.empty);",
									"}"
								]
							}
						}
