	"customDictionary.create": {
		"html": [
			"<x-ncdialog name=\"Add custom dictionary\" open=\"true\" size=\"normal\" data-onupdate:open=\"[null,null]\">",
			"<x-slot name=\"actions\">",
			"<x-ncbutton disabled=\"false\" data-testid=\"cn-dialog-actions-cancel\" data-on-onclick=\"\">",
			"<x-slot name=\"default\">Cancel</x-slot>",
			"</x-ncbutton>",
			"<x-ncbutton variant=\"primary\" disabled=\"true\" data-testid=\"cn-dialog-actions-submit\" data-on-onclick=\"\">",
			"<x-slot name=\"default\"> Create</x-slot>",
			"</x-ncbutton>",
			"</x-slot>",
			"<x-slot name=\"default\">",
			"<div class=\"custom-dictionary-form\">",
			"<x-nctextfield modelvalue=\"\" data-on-onupdate:modelvalue=\"\" label=\"Label\" required=\"\">",
			"</x-nctextfield>",
			"<x-nctextfield modelvalue=\"\" data-on-onupdate:modelvalue=\"\" label=\"Description (optional)\">",
			"</x-nctextfield>",
			"<div class=\"custom-dictionary-form__colour-row\">",
			"<label class=\"custom-dictionary-form__colour-label\" for=\"custom-dictionary-colour\">Colour</label>",
			"<input id=\"custom-dictionary-colour\" type=\"color\" class=\"custom-dictionary-form__colour-input\">",
			"<x-nctextfield modelvalue=\"#0082C9\" data-on-onupdate:modelvalue=\"\" label=\"Hex value\" class=\"custom-dictionary-form__colour-hex\">",
			"</x-nctextfield>",
			"</div>",
			"<!--",
			"\t\t\t\t`v-model`, NOT `:value` + `@input`.",
			"",
			"\t\t\t\tThis was a Vue 2 binding left behind by the Vue 3 migration, and",
			"\t\t\t\tit made the control INERT rather than merely mis-styled.",
			"\t\t\t\t`@nextcloud/vue` 9.9.0's NcSelect declares a `modelValue` prop,",
			"\t\t\t\tdeclares NO `value` prop at all, and its only declared emit is",
			"\t\t\t\t`update:modelValue` (verified in the installed",
			"\t\t\t\tdist/chunks/NcSelect-*.mjs). So `:value` bound nothing — the",
			"\t\t\t\tselect rendered with no `.vs__selected` at all — and `@input`",
			"\t\t\t\tnever fired, so picking a match mode did not change",
			"\t\t\t\t`form.matchMode`. Every dictionary created or edited through this",
			"\t\t\t\tdialog was written with the `caseInsensitive` default no matter",
			"\t\t\t\twhat the user chose, silently.",
			"",
			"\t\t\t\tThe sibling select in PolicyRuleFormModal.vue already uses",
			"\t\t\t\t`v-model` and works; this was the only `:value`-bound NcSelect",
			"\t\t\t\tleft in src/ (swept 2026-08-11).",
			"\t\t\t-->",
			"<x-ncselect modelvalue=\"caseInsensitive\" data-on-onupdate:modelvalue=\"\" data-options=\"[{&quot;value&quot;:&quot;exact&quot;,&quot;label&quot;:&quot;Exact (case-sensitive)&quot;},{&quot;value&quot;:&quot;caseInsensitive&quot;,&quot;label&quot;:&quot;Case-insensitive&quot;},{&quot;value&quot;:&quot;wordBoundary&quot;,&quot;label&quot;:&quot;Word boundary&quot;}]\" label=\"label\" data-on-reduce=\"\" clearable=\"false\" inputlabel=\"Match mode\" required=\"\">",
			"</x-ncselect>",
			"<p class=\"custom-dictionary-form__hint\">Exact matches case-sensitively; case-insensitive (default) folds case; word boundary is case-insensitive but never matches inside a longer word.</p>",
			"<x-nccheckboxradioswitch modelvalue=\"true\" data-on-onupdate:modelvalue=\"\" type=\"switch\">",
			"<x-slot name=\"default\">Active (used in automatic detection)</x-slot>",
			"</x-nccheckboxradioswitch>",
			"<!--v-if-->",
			"</div>",
			"</x-slot>",
			"</x-ncdialog>"
		],
		"buttons": [
			{
				"variant": null,
				"emitted": [["onCancel"]]
			},
			{
				"variant": "primary",
				"emitted": []
			}
		]
	},
