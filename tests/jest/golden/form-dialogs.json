			"</x-nctextfield>",
			"<x-nctextfield modelvalue=\"\" data-on-onupdate:modelvalue=\"\" label=\"Valid until (ISO 8601, optional)\">",
			"</x-nctextfield>",
			"<x-nccheckboxradioswitch modelvalue=\"true\" data-on-onupdate:modelvalue=\"\" type=\"switch\">",
			"<x-slot name=\"default\">Active</x-slot>",
			"</x-nccheckboxradioswitch>",
