	"prohibition.create": {
		"html": [
			"<x-ncdialog name=\"Add publish-never rule\" open=\"true\" size=\"normal\" data-on-onupdate:open=\"\">",
			"<x-slot name=\"actions\">",
			"<x-ncbutton disabled=\"false\" data-testid=\"cn-dialog-actions-cancel\" data-on-onclick=\"\">",
			"<x-slot name=\"default\">Cancel</x-slot>",
			"</x-ncbutton>",
			"<x-ncbutton variant=\"primary\" disabled=\"true\" data-testid=\"cn-dialog-actions-submit\" data-on-onclick=\"\">",
			"<x-slot name=\"default\"> Create</x-slot>",
			"</x-ncbutton>",
			"</x-slot>",
			"<x-slot name=\"default\">",
			"<div class=\"prohibition-form\">",
			"<x-nctextfield modelvalue=\"\" data-on-onupdate:modelvalue=\"\" label=\"Primary name (Dutch)\" required=\"true\">",
			"</x-nctextfield>",
			"<x-ncselect modelvalue=\"PERSON\" data-on-onupdate:modelvalue=\"\" data-options=\"[&quot;PERSON&quot;,&quot;ORGANIZATION&quot;,&quot;OTHER&quot;]\" inputlabel=\"Entity type\" label=\"Entity type\" required=\"true\">",
			"</x-ncselect>",
			"<x-nctextfield modelvalue=\"\" data-on-onupdate:modelvalue=\"\" label=\"Reason (markdown allowed)\" required=\"true\">",
			"</x-nctextfield>",
			"<x-nctextfield modelvalue=\"\" data-on-onupdate:modelvalue=\"\" label=\"Legal authority (court order, statute, …)\">",
			"</x-nctextfield>",
			"<x-nctextfield modelvalue=\"\" data-on-onupdate:modelvalue=\"\" label=\"Case reference (optional)\">",
			"</x-nctextfield>",
			"<x-ncselect modelvalue=\"medium\" data-on-onupdate:modelvalue=\"\" data-options=\"[&quot;high&quot;,&quot;medium&quot;,&quot;low&quot;]\" inputlabel=\"Severity\" label=\"Severity\">",
			"</x-ncselect>",
			"<x-nctextfield modelvalue=\"\" data-on-onupdate:modelvalue=\"\" label=\"Jurisdiction (optional)\">",
			"</x-nctextfield>",
			"<x-nctextfield modelvalue=\"\" data-on-onupdate:modelvalue=\"\" label=\"Valid until (ISO 8601, optional)\">",
			"</x-nctextfield>",
			"<x-nccheckboxradioswitch modelvalue=\"true\" data-on-onupdate:modelvalue=\"\" type=\"switch\">",
			"<x-slot name=\"default\">Active</x-slot>",
			"</x-nccheckboxradioswitch>",
			"<!--v-if-->",
			"<h4>Match rules</h4>",
			"<div class=\"form-warning\">Add at least one match rule. Prefer stable identifiers (BSN/KvK) over name-only matches — names alone produce false positives.</div>",
			"<x-ncbutton variant=\"secondary\" data-on-onclick=\"\">",
			"<x-slot name=\"default\">Add match rule</x-slot>",
			"</x-ncbutton>",
			"</div>",
			"</x-slot>",
			"</x-ncdialog>"
