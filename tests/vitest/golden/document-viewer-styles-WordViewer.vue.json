{
	"elements": {
		"word-viewer": {
			"display": "flex",
			"justify-content": "center",
			"padding": "16px",
			"background": "var(--color-background-dark)",
			"min-height": "100%"
		},
		"word-viewer__loading": {
			"display": "flex",
			"flex-direction": "column",
			"align-items": "center",
			"gap": "8px",
			"padding": "32px",
			"color": "var(--color-text-maxcontrast)"
		},
		"word-viewer__error": {
			"display": "flex",
			"flex-direction": "column",
			"align-items": "center",
			"gap": "8px",
			"padding": "32px",
			"color": "var(--color-text-maxcontrast)"
		},
		"word-viewer__page": {
			"background": "white",
			"color": "black",
			"max-width": "800px",
			"width": "100%",
			"padding": "48px",
			"box-shadow": "var(--dd-shadow-doc)",
			"border-radius": "var(--border-radius)"
		},
		"word-viewer__content": {
			"font-family": "'Calibri', 'Arial', sans-serif",
			"font-size": "14px",
			"line-height": "1.6"
		}
	},
	"other": []
}
