{
	"elements": {
		"odt-viewer": {
			"display": "flex",
			"justify-content": "center",
			"padding": "16px",
			"background": "var(--color-background-dark)",
			"min-height": "100%"
		},
		"odt-viewer__loading": {
			"display": "flex",
			"flex-direction": "column",
			"align-items": "center",
			"gap": "8px",
			"padding": "32px",
			"color": "var(--color-text-maxcontrast)"
		},
		"odt-viewer__error": {
			"display": "flex",
			"flex-direction": "column",
			"align-items": "center",
			"gap": "8px",
			"padding": "32px",
			"color": "var(--color-text-maxcontrast)"
		},
		"odt-viewer__page": {
			"background": "white",
			"color": "black",
			"max-width": "800px",
			"width": "100%",
			"padding": "48px",
			"box-shadow": "var(--dd-shadow-doc)",
			"border-radius": "var(--border-radius)"
		},
		"odt-viewer__content": {
			"font-family": "'Calibri', 'Arial', sans-serif",
			"font-size": "14px",
			"line-height": "1.6"
		}
	},
	"other": [
		{
			"selector": ".odt-viewer__content h1",
			"decls": {
				"margin-top": "1.2em",
				"margin-bottom": "0.4em",
				"color": "#000"
			}
		},
		{
			"selector": ".odt-viewer__content h2",
			"decls": {
				"margin-top": "1.2em",
				"margin-bottom": "0.4em",
				"color": "#000"
			}
		},
		{
			"selector": ".odt-viewer__content h3",
			"decls": {
				"margin-top": "1.2em",
				"margin-bottom": "0.4em",
				"color": "#000"
			}
		},
		{
			"selector": ".odt-viewer__content p",
			"decls": {
				"margin": "0 0 1em 0"
			}
		},
		{
			"selector": ".odt-viewer__content table",
			"decls": {
				"border-collapse": "collapse",
				"margin": "1em 0"
			}
		},
		{
			"selector": ".odt-viewer__content table td",
			"decls": {
				"border": "1px solid #ddd",
				"padding": "6px 10px"
			}
		},
		{
			"selector": ".odt-viewer__content table th",
			"decls": {
				"border": "1px solid #ddd",
				"padding": "6px 10px"
			}
		}
	]
}
