                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON array', function () { var json = pm.response.json(); pm.expect(json).to.be.an('array'); });",
                  "pm.test('Seed prohibitions present', function () { var json = pm.response.json(); pm.expect(json.length).to.be.at.least(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/policy/prohibitions (create)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/policy/prohibitions", "host": ["{{baseUrl}}"], "path": ["api", "policy", "prohibitions"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"primaryName\":\"Newman Test Subject\",\"entityType\":\"PERSON\",\"reason\":\"Newman integration test fixture\",\"matchRules\":[{\"type\":\"exact\",\"value\":\"Newman Test Subject\"}],\"active\":true}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.test('Returns UUID', function () { pm.expect(json['@self'] && json['@self'].id || json.id || json.uuid).to.be.a('string'); });",
                  "if (json['@self'] && json['@self'].id) { pm.collectionVariables.set('createdProhibitionId', json['@self'].id); }",
                  "else if (json.id) { pm.collectionVariables.set('createdProhibitionId', json.id); }"
                ]
              }
            }
          ]
        },
