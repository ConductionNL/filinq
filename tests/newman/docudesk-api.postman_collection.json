        {
          "name": "POST /api/pdf/render (valid template)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/pdf/render", "host": ["{{baseUrl}}"], "path": ["api", "pdf", "render"] },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"template\": \"<h1>Hello {{ name }}</h1>\", \"data\": {\"name\": \"World\"}, \"filename\": \"test.pdf\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Content-Type is PDF', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'); });"
                ]
