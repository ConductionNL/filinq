                  "pm.test('Response is array', function () { var json = pm.response.json(); pm.expect(json).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/anonymization/extract/999999 (not found)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/anonymization/extract/999999", "host": ["{{baseUrl}}"], "path": ["api", "anonymization", "extract", "999999"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 500 for non-existent file', function () { pm.response.to.have.status(500); });",
                  "pm.test('Has error field', function () { var json = pm.response.json(); pm.expect(json).to.have.property('error'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/anonymization/anonymize/999999 (no entities)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/anonymization/anonymize/999999", "host": ["{{baseUrl}}"], "path": ["api", "anonymization", "anonymize", "999999"] },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400 for no entities', function () { pm.response.to.have.status(400); });",
                  "pm.test('Has error field', function () { var json = pm.response.json(); pm.expect(json).to.have.property('error'); });"
                ]
              }
            }
          ]
        }
      ]
    },
