              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON array of scope=entity records', function () { var json = pm.response.json(); pm.expect(json).to.be.an('array'); json.forEach(function (r) { pm.expect(r.scope || 'document').to.equal('entity'); }); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/policy/standing-consents (scope validation: missing consentMethod)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/policy/standing-consents", "host": ["{{baseUrl}}"], "path": ["api", "policy", "standing-consents"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"entityText\":\"Newman Test Standing\",\"entityType\":\"PERSON\",\"matchRules\":[{\"type\":\"exact\",\"value\":\"Newman Test Standing\"}],\"active\":true}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejected (400 validation, 403 group-perm, or 500 if not configured)', function () { pm.expect([400, 403, 500]).to.include(pm.response.code); });",
                  "pm.test('Has error message', function () { var json = pm.response.json(); pm.expect(json).to.have.property('error'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/policy/standing-consents (scope validation: documentId not allowed)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/policy/standing-consents", "host": ["{{baseUrl}}"], "path": ["api", "policy", "standing-consents"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"entityText\":\"Newman\",\"entityType\":\"PERSON\",\"matchRules\":[{\"type\":\"exact\",\"value\":\"Newman\"}],\"consentMethod\":\"paper\",\"documentId\":\"some-doc\",\"active\":true}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejected (400 validation, 403 group-perm, or 500 if not configured)', function () { pm.expect([400, 403, 500]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        }
      ]
