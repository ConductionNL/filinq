{
  "info": {
    "name": "DocuDesk API Tests",
    "_postman_id": "docudesk-api-tests",
    "description": "API tests for DocuDesk Nextcloud app",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/index.php/apps/docudesk"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "admin"
    }
  ],
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{username}}", "type": "string" },
      { "key": "password", "value": "{{password}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Has status field', function () { var json = pm.response.json(); pm.expect(json).to.have.property('status'); });",
                  "pm.test('Has checks field', function () { var json = pm.response.json(); pm.expect(json).to.have.property('checks'); });",
                  "pm.test('Database check present', function () { var json = pm.response.json(); pm.expect(json.checks).to.have.property('database'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Settings",
      "item": [
        {
          "name": "GET /api/settings",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/settings", "host": ["{{baseUrl}}"], "path": ["api", "settings"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Has objectTypes', function () { var json = pm.response.json(); pm.expect(json).to.have.property('objectTypes'); });",
                  "pm.test('Has configuration', function () { var json = pm.response.json(); pm.expect(json).to.have.property('configuration'); });",
                  "pm.test('Has openRegisters flag', function () { var json = pm.response.json(); pm.expect(json).to.have.property('openRegisters'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/settings",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/settings", "host": ["{{baseUrl}}"], "path": ["api", "settings"] },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"enable_language_detection\": \"1\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Anonymization",
      "item": [
        {
          "name": "GET /api/anonymization/files",
          "request": {
            "method": "GET",
