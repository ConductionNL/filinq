# DocuDesk — Conduction PHPStan config.
#
# The shared base is the single source of truth. Everything here is either the
# app's own tracked debt or an ignore naming a symbol that exists in no other
# fleet app. Anything you are tempted to add that another app would also need
# belongs in the base, not here.
includes:
    - vendor/conduction/hydra-gates/quality-config/phpstan-base.neon
    # Per-app tracked lint debt (auto-generated via `phpstan --generate-baseline`).
    - phpstan-baseline.neon

parameters:
    # App-specific only. The base already sets level, paths, bootstrapFiles,
    # excludePaths, scanDirectories and every fleet-wide ignore.
    excludePaths:
        # AppHost-delegator controllers: thin subclasses of OCA\OpenRegister\AppHost classes
        # that are absent during static analysis (OR is co-installed at runtime only).
        # PHPStan disallows ignoreErrors for "extends unknown class" — excludePaths is the
        # mandated approach. No logic lives in these files; the only risk is the parent call.
        - lib/Controller/DashboardController.php
        - lib/Controller/HealthController.php
        - lib/Controller/MetricsController.php

    scanFiles:
        # AppHost generic preferences controller stub, so the thin
        # OCA\DocuDesk\Controller\PreferencesController subclass resolves its
        # parent during static analysis when the openregister sibling app is
        # absent from the analysis path. PHPStan refuses to let an
        # "extends unknown class" error be silenced through ignoreErrors, and a
        # truthful stub (mirroring the real engine constructor) beats an
        # excludePaths suppression: it also type-checks the named arguments
        # Application::register() passes to the engine constructor.
        # The real class lives in openregister/lib/AppHost/Controller/.
        - tests/stubs/openregister-apphost.stub.php
        # OpenRegister's MCP contracts (ADR-063 chain 3/3), for the same reason:
        # PHPStan refuses to silence "implements unknown interface" through
        # ignoreErrors and points at excludePaths, which would stop analysing
        # DocudeskScannableServices entirely. The stub also type-checks the named
        # arguments every #[McpTool] declaration passes.
        - tests/stubs/openregister-mcp.stub.php

    ignoreErrors:
        # @template-implements IEventListener<OCA\OpenRegister\Event\*> in listeners:
        # OR events are absent in static analysis — the generic bound check fails
        # and registerEventListener rejects the class-string as not matching
        # IEventListener<Event>. Both errors stem from the same missing OR type.
        - '#is not subtype of template type T of OCP\\\\EventDispatcher\\\\Event#'
        - '#expects class-string.OCP\\\\EventDispatcher\\\\IEventListener.OCP\\\\EventDispatcher\\\\Event..,.+DossierCheckedOnListener.+given#'
        # TesseractOCR uses __call magic methods for lang(), dpi() etc.
        - '#Call to an undefined method .+TesseractOCR::#'
        # DI-injected properties in scaffold classes not yet using them
        - '#Property .+ is never read, only written#'
        # PhpOffice\PhpWord — declared in composer.json as a require but
        # the package is only loaded after `composer install` resolves
        # it; in CI / fresh-checkout phpstan runs without the package
        # vendored. The PhpWordBackend usages are guarded by
        # class_exists() in isAvailable(), so the runtime behaviour is
        # safe. Same exemption pattern as the OpenRegister ignores in the base.
        - '#unknown class PhpOffice\\PhpWord\\#'
        - '#static method [^ ]+ on an unknown class PhpOffice\\PhpWord\\#'
        - '#Access to constant [^ ]+ on an unknown class PhpOffice\\PhpWord\\#'
        # Defensive guards whose PHPDoc-narrowed types make phpstan treat the negated
        # check as unreachable. The guards stay — Nextcloud's File implementation can
        # fail under quota / locked-file conditions and we'd rather emit a typed
        # ConversionFailedException than crash the cascade.
        - '#Strict comparison using === between true and false will always evaluate to false#'
