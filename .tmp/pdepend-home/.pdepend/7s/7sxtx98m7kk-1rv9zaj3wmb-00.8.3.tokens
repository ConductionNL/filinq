ndColumn";i:15;}i:634;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:118;s:5:"image";s:1:",";s:9:"startLine";i:363;s:7:"endLine";i:363;s:11:"startColumn";i:16;s:9:"endColumn";i:16;}i:635;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:116;s:5:"image";s:12:"$orientation";s:9:"startLine";i:363;s:7:"endLine";i:363;s:11:"startColumn";i:18;s:9:"endColumn";i:29;}i:636;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:7;s:5:"image";s:1:")";s:9:"startLine";i:363;s:7:"endLine";i:363;s:11:"startColumn";i:30;s:9:"endColumn";i:30;}i:637;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:13;s:5:"image";s:1:";";s:9:"startLine";i:363;s:7:"endLine";i:363;s:11:"startColumn";i:31;s:9:"endColumn";i:31;}i:638;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:100;s:5:"image";s:6:"return";s:9:"startLine";i:365;s:7:"endLine";i:365;s:11:"startColumn";i:3;s:9:"endColumn";i:8;}i:639;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:48;s:5:"image";s:801:"'<style>
@media print {
    body {
        margin: 0;
        padding: 0;
        font-family: "DejaVu Sans", sans-serif;
    }
    figure, img, pre, blockquote {
        page-break-inside: avoid;
    }
    /*
     * Let large data tables flow across pages instead of being crammed
     * onto one page. `page-break-inside: avoid` is applied to each ROW so
     * rows are never split mid-cell, while the table itself may break at
     * row boundaries. `thead { table-header-group }` makes mPDF repeat the
     * column header on every page the table spans.
     */
    tr {
        page-break-inside: avoid;
    }
    thead {
        display: table-header-group;
    }
    h1, h2, h3, h4, h5, h6 {
        page-break-after: avoid;
    }
    nav, .no-print {
        display: none;
    }
}
</style>
