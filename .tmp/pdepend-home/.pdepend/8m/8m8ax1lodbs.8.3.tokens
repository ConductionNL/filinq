 * Serves `GET|PUT /api/preferences/{key}` for Filinq.
 *
 * Behaviour (auth posture, key sanitisation, per-user scoping) is a
 * byte-for-byte reimplementation of OpenRegister's generic. `#[NoAdminRequired]`
 * was previously INHERITED from the generic; it is declared explicitly on both
 * methods here so the auth posture is unchanged by dropping the inheritance —
 * any logged-in user may read and write their OWN preferences, and the
 * `$user === null` guard still rejects anonymous callers with 401.
 */";s:9:"startLine";i:68;s:7:"endLine";i:77;s:11:"startColumn";i:1;s:9:"endColumn";i:3;}i:75;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:1;s:5:"image";s:5:"class";s:9:"startLine";i:78;s:7:"endLine";i:78;s:11:"startColumn";i:1;s:9:"endColumn";i:5;}i:76;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:11;s:5:"image";s:21:"PreferencesController";s:9:"startLine";i:78;s:7:"endLine";i:78;s:11:"startColumn";i:7;s:9:"endColumn";i:27;}i:77;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:64;s:5:"image";s:7:"extends";s:9:"startLine";i:78;s:7:"endLine";i:78;s:11:"startColumn";i:29;s:9:"endColumn";i:35;}i:78;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:11;s:5:"image";s:10:"Controller";s:9:"startLine";i:78;s:7:"endLine";i:78;s:11:"startColumn";i:37;s:9:"endColumn";i:46;}i:79;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:4;s:5:"image";s:1:"{";s:9:"startLine";i:78;s:7:"endLine";i:78;s:11:"startColumn";i:48;s:9:"endColumn";i:48;}i:80;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:12;s:5:"image";s:233:"/**
	 * Constructor.
	 *
