s:4:"type";i:145;s:5:"image";s:1:"\";s:9:"startLine";i:21;s:7:"endLine";i:21;s:11:"startColumn";i:21;s:9:"endColumn";i:21;}i:14;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:11;s:5:"image";s:9:"Exception";s:9:"startLine";i:21;s:7:"endLine";i:21;s:11:"startColumn";i:22;s:9:"endColumn";i:30;}i:15;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:13;s:5:"image";s:1:";";s:9:"startLine";i:21;s:7:"endLine";i:21;s:11:"startColumn";i:31;s:9:"endColumn";i:31;}i:16;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:114;s:5:"image";s:3:"use";s:9:"startLine";i:23;s:7:"endLine";i:23;s:11:"startColumn";i:1;s:9:"endColumn";i:3;}i:17;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:11;s:5:"image";s:16:"RuntimeException";s:9:"startLine";i:23;s:7:"endLine";i:23;s:11:"startColumn";i:5;s:9:"endColumn";i:20;}i:18;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:13;s:5:"image";s:1:";";s:9:"startLine";i:23;s:7:"endLine";i:23;s:11:"startColumn";i:21;s:9:"endColumn";i:21;}i:19;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:12;s:5:"image";s:1156:"/**
 * A read of the agreement store that failed, rather than one that found nothing.
 *
 * 🔴 THIS EXCEPTION EXISTS BECAUSE THE TWO ANSWERS LOOKED THE SAME. The store
 * used to swallow a read failure into an empty list, and an empty list means
 * "no agreement was declared", which means "this file is not gated". So a
 * register that was down, or a schema that did not resolve, read as permission
 * to download. Raising instead of returning keeps the failure a failure, and
 * the gate turns it into a refusal.
 *
 * 🔑 IT IS NOT THROWN WHEN THE SCHEMA IS SIMPLY ABSENT. An instance that never
 * imported `downloadAgreement` gates nothing, which is a real answer rather
 * than a failed read, and refusing every download there would take the whole
 * download surface down over a feature nobody enabled.
 *
 * @category Exception
 * @package  OCA\Filinq\Exception
 * @author   Conduction B.V. <info@conduction.nl>
 * @license  EUPL-1.2 https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12
 * @link     https://www.filinq.app
 *
 * @spec openspec/changes/redaction-and-what-leaves-the-building/specs/redaction-output-guarantee/spec.md
 */";s:9:"startLine";i:25;s:7:"endLine";i:47;s:11:"startColumn";i:1;s:9:"endColumn";i:3;}i:20;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:1;s:5:"image";s:5:"class";s:9:"startLine";i:48;s:7:"endLine";i:48;s:11:"startColumn";i:1;s:9:"endColumn";i:5;}i:21;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:11;s:5:"image";s:33:"AgreementStoreUnreadableException";s:9:"startLine";i:48;s:7:"endLine";i:48;s:11:"startColumn";i:7;s:9:"endColumn";i:39;}i:22;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:64;s:5:"image";s:7:"extends";s:9:"startLine";i:48;s:7:"endLine";i:48;s:11:"startColumn";i:41;s:9:"endColumn";i:47;}i:23;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:11;s:5:"image";s:16:"RuntimeException";s:9:"startLine";i:48;s:7:"endLine";i:48;s:11:"startColumn";i:49;s:9:"endColumn";i:64;}i:24;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:4;s:5:"image";s:1:"{";s:9:"startLine";i:48;s:7:"endLine";i:48;s:11:"startColumn";i:66;s:9:"endColumn";i:66;}i:25;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:5;s:5:"image";s:1:"}";s:9:"startLine";i:50;s:7:"endLine";i:50;s:11:"startColumn";i:1;s:9:"endColumn";i:1;}i:26;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:137;s:5:"image";s:11:"//end class";s:9:"startLine";i:50;s:7:"endLine";i:50;s:11:"startColumn";i:2;s:9:"endColumn";i:12;}}}