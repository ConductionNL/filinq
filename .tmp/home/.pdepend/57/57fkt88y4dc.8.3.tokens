s:4:"type";i:145;s:5:"image";s:1:"\";s:9:"startLine";i:21;s:7:"endLine";i:21;s:11:"startColumn";i:21;s:9:"endColumn";i:21;}i:14;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:11;s:5:"image";s:9:"Exception";s:9:"startLine";i:21;s:7:"endLine";i:21;s:11:"startColumn";i:22;s:9:"endColumn";i:30;}i:15;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:13;s:5:"image";s:1:";";s:9:"startLine";i:21;s:7:"endLine";i:21;s:11:"startColumn";i:31;s:9:"endColumn";i:31;}i:16;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:114;s:5:"image";s:3:"use";s:9:"startLine";i:23;s:7:"endLine";i:23;s:11:"startColumn";i:1;s:9:"endColumn";i:3;}i:17;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:11;s:5:"image";s:16:"RuntimeException";s:9:"startLine";i:23;s:7:"endLine";i:23;s:11:"startColumn";i:5;s:9:"endColumn";i:20;}i:18;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:13;s:5:"image";s:1:";";s:9:"startLine";i:23;s:7:"endLine";i:23;s:11:"startColumn";i:21;s:9:"endColumn";i:21;}i:19;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:12;s:5:"image";s:1210:"/**
 * A read of the merge job store that failed, rather than one that found nothing.
 *
 * 🔴 THIS EXCEPTION EXISTS BECAUSE THE TWO ANSWERS LOOKED THE SAME. The store
 * swallowed a read failure into `null`, and `null` means "there is no merge
 * with that id". So a register that was down, or a schema that did not
 * resolve, reached the polling caller as a 404: the person watching a queued
 * merge was told their merge did not exist, while it sat in the queue. The
 * client then stops polling, because a merge that is gone is not coming back.
 *
 * 🔑 IT IS NOT THROWN FOR A GENUINE ABSENCE. An id nobody ever queued still
 * reads as `null`, and still answers 404, because that is a true answer.
 *
 * The queue read raises for the same reason from the other side: an empty
 * queue and an unreadable queue both made MergeDocumentsJob report a clean
 * run over a queue it never saw.
 *
 * @category Exception
 * @package  OCA\Filinq\Exception
 * @author   Conduction B.V. <info@conduction.nl>
 * @license  EUPL-1.2 https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12
 * @link     https://www.filinq.app
 *
 * @spec openspec/changes/merge-documents-to-pdf/specs/document-merge/spec.md
 */";s:9:"startLine";i:25;s:7:"endLine";i:49;s:11:"startColumn";i:1;s:9:"endColumn";i:3;}i:20;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:1;s:5:"image";s:5:"class";s:9:"startLine";i:50;s:7:"endLine";i:50;s:11:"startColumn";i:1;s:9:"endColumn";i:5;}i:21;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:11;s:5:"image";s:32:"MergeJobStoreUnreadableException";s:9:"startLine";i:50;s:7:"endLine";i:50;s:11:"startColumn";i:7;s:9:"endColumn";i:38;}i:22;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:64;s:5:"image";s:7:"extends";s:9:"startLine";i:50;s:7:"endLine";i:50;s:11:"startColumn";i:40;s:9:"endColumn";i:46;}i:23;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:11;s:5:"image";s:16:"RuntimeException";s:9:"startLine";i:50;s:7:"endLine";i:50;s:11:"startColumn";i:48;s:9:"endColumn";i:63;}i:24;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:4;s:5:"image";s:1:"{";s:9:"startLine";i:50;s:7:"endLine";i:50;s:11:"startColumn";i:65;s:9:"endColumn";i:65;}i:25;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:5;s:5:"image";s:1:"}";s:9:"startLine";i:52;s:7:"endLine";i:52;s:11:"startColumn";i:1;s:9:"endColumn";i:1;}i:26;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:137;s:5:"image";s:11:"//end class";s:9:"startLine";i:52;s:7:"endLine";i:52;s:11:"startColumn";i:2;s:9:"endColumn";i:12;}}}