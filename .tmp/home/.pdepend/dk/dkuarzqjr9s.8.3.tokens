	 * Produce a verifiable signed artifact from the original document bytes.
	 *
	 * Given the original document content (already a writeable PDF), the
	 * provider returns the signed document bytes. The native provider embeds a
	 * `/DocuDesk-Signature(...)` marker carrying an HMAC over the document
	 * content-hash so the artifact passes
	 * `SigningVerificationService::verifyDocument()`. External providers return
	 * the file their remote signing service produced.
	 *
	 * Honest-completion gate: a provider that cannot currently produce a signed
	 * artifact (native writer disabled, `signing_verification_secret` unset, or
	 * an external provider unconfigured/stubbed) MUST throw a descriptive
	 * exception rather than return the unsigned original — so the completing
	 * signature fails loudly instead of mislabelling the original as signed.
	 *
	 * @param string $documentContent The original document bytes.
	 * @param array<string, mixed> $context Signing context: signer,
	 *                                      signers, timestamp, ip,
	 *                                      level.
	 *
	 * @return string The signed document bytes.
	 *
	 * @throws \RuntimeException When no signed artifact can be produced.
	 *
	 * @spec openspec/specs/document-signing/spec.md
	 */";s:9:"startLine";i:135;s:7:"endLine";i:161;s:11:"startColumn";i:2;s:9:"endColumn";i:4;}i:115;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:96;s:5:"image";s:6:"public";s:9:"startLine";i:162;s:7:"endLine";i:162;s:11:"startColumn";i:2;s:9:"endColumn";i:7;}i:116;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:9;s:5:"image";s:8:"function";s:9:"startLine";i:162;s:7:"endLine";i:162;s:11:"startColumn";i:9;s:9:"endColumn";i:16;}i:117;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:11;s:5:"image";s:21:"produceSignedArtifact";s:9:"startLine";i:162;s:7:"endLine";i:162;s:11:"startColumn";i:18;s:9:"endColumn";i:38;}i:118;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:6;s:5:"image";s:1:"(";s:9:"startLine";i:162;s:7:"endLine";i:162;s:11:"startColumn";i:39;s:9:"endColumn";i:39;}i:119;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:11;s:5:"image";s:6:"string";s:9:"startLine";i:162;s:7:"endLine";i:162;s:11:"startColumn";i:40;s:9:"endColumn";i:45;}i:120;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:116;s:5:"image";s:16:"$documentContent";s:9:"startLine";i:162;s:7:"endLine";i:162;s:11:"startColumn";i:47;s:9:"endColumn";i:62;}i:121;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:118;s:5:"image";s:1:",";s:9:"startLine";i:162;s:7:"endLine";i:162;s:11:"startColumn";i:63;s:9:"endColumn";i:63;}i:122;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:17;s:5:"image";s:5:"array";s:9:"startLine";i:162;s:7:"endLine";i:162;s:11:"startColumn";i:65;s:9:"endColumn";i:69;}i:123;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:116;s:5:"image";s:8:"$context";s:9:"startLine";i:162;s:7:"endLine";i:162;s:11:"startColumn";i:71;s:9:"endColumn";i:78;}i:124;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:7;s:5:"image";s:1:")";s:9:"startLine";i:162;s:7:"endLine";i:162;s:11:"startColumn";i:79;s:9:"endColumn";i:79;}i:125;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:125;s:5:"image";s:1:":";s:9:"startLine";i:162;s:7:"endLine";i:162;s:11:"star