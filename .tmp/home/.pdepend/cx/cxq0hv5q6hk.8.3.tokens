a:2:{s:4:"hash";N;s:4:"data";a:314:{i:0;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:92;s:5:"image";s:5:"<?php";s:9:"startLine";i:1;s:7:"endLine";i:1;s:11:"startColumn";i:1;s:9:"endColumn";i:5;}i:1;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:12;s:5:"image";s:1865:"/**
 * Dossier Controller
 *
 * HTTP entry points for dossier-level operations. Currently surfaces a
 * single endpoint — `POST /api/anonymization/dossier/{dossierId}/grondslagen-pdf`
 * — which (re)generates the per-dossier grondslagen summary PDF aggregating
 * every redacted entity under the dossier's folder. See
 * `LegalBasesSummaryService::renderDossierSummary` for the render itself.
 *
 * Authentication is required (the route is `@NoAdminRequired` but
 * non-anonymous).
 *
 * ⚠️ Authorisation, stated accurately. This header used to say the caller
 * "MUST be able to read the dossier object via OpenRegister's standard RBAC".
 * Half of that sentence is enforced and half is not:
 *
 *  - The FILE half is real. `renderDossierSummary` walks the dossier folder
 *    through the session user's view, so a file the operator cannot see does
 *    not enter the summary.
 *  - The OBJECT half is not. The pre-render check resolves to an existence
 *    test only, because the `dossier` schema declares `"authorization": null`
 *    and OpenRegister treats an unconfigured cascade as open. See
 *    `DossierSummaryDataService::assertDossierReadable()`.
 *
 * So any authenticated user in the organisation can trigger a regen for any
 * dossier uuid they can name; what they get back is scoped to the files they
 * can already see. Tracked in ConductionNL/filinq#441.
 *
 * @category  Controller
 * @package   OCA\Filinq\Controller
 * @author    Conduction B.V. <info@conduction.nl>
 * @copyright 2026 Conduction B.V.
 * @license   EUPL-1.2 https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12
 * @version   GIT: <git_id>
 * @link      https://www.filinq.app
 *
 * @spec openspec/specs/anonymisation-grondslagen-summary/spec.md
 *
 * SPDX-FileCopyrightText: 2026 Conduction B.V. <info@conduction.nl>
 * SPDX-License-Identifier: EUPL-1.2
 */";s:9:"startLine";i:3;s:7:"endLine";i:43;s:11:"startColumn";i:1;s:9:"endColumn";i:3;}i:2;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:51;s:5:"image";s:7:"declare";s:9:"startLine";i:45;s:7:"endLine";i:45;s:11:"startColumn";i:1;s:9:"endColumn";i:7;}i:3;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:6;s:5:"image";s:1:"(";s:9:"startLine";i:45;s:7:"endLine";i:45;s:11:"startColumn";i:8;s:9:"endColumn";i:8;}i:4;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:11;s:5:"image";s:12:"strict_types";s:9:"startLine";i:45;s:7:"endLine";i:45;s:11:"startColumn";i:9;s:9:"endColumn";i:20;}i:5;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:19;s:5:"image";s:1:"=";s:9:"startLine";i:45;s:7:"endLine";i:45;s:11:"startColumn";i:21;s:9:"endColumn";i:21;}i:6;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:83;s:5:"image";s:1:"1";s:9:"startLine";i:45;s:7:"endLine";i:45;s:11:"startColumn";i:22;s:9:"endColumn";i:22;}i:7;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:7;s:5:"image";s:1:")";s:9:"startLine";i:45;s:7:"endLine";i:45;s:11:"startColumn";i:23;s:9:"endColumn";i:23;}i:8;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:13;s:5:"image";s:1:";";s:9:"startLine";i:45;s:7:"endLine";i:45;s:11:"startColumn";i:24;s:9:"endColumn";i:24;}i:9;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:138;s:5:"image";s:9:"namespace";s:9:"startLine";i:47;s:7:"endLine";i:47;s:11:"startColumn";i:1;s:9:"endColumn";i:9;}i:10;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:11;s:5:"image";s:3:"OCA";s:9:"startLine";i:47;s:7:"endLine";i:47;s:11:"startColumn";i:11;s:9:"endColumn";i:13;}i:11;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:145;s:5:"image";s:1:"\";s:9:"startLine";i:47;s:7:"endLine";i:47;s:11:"startColumn";i:14;s:9:"endColumn";i:14;}i:12;O:30:"PDepend\Source\Tokenizer\Token":6:{s:4:"type";i:11;s:5:"image";s:6:"Filinq";s:9:"startLine";i:47;s:7:"endLine";i:47;s:11:"startColumn";i:15;s:9:"endColumn";i:20;}i:13;O:30:"PDepend\Source\Tokenizer\Token":6:{