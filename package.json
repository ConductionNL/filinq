{
  "name": "filinq",
  "version": "1.0.0",
  "license": "EUPL-1.2",
  "engines": {
    "node": "^22.14 || ^24 || >=26",
    "npm": "^11.0.0"
  },
  "scripts": {
    "test:l10n": "node tests/l10n/check-l10n.js",
    "test:l10n:write": "node tests/l10n/check-l10n.js --write",
    "build": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "dev": "NODE_ENV=development webpack --config webpack.config.js --progress",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --progress --watch",
    "lint": "eslint src",
    "lint-fix": "npm run lint -- --fix && npm run format:fix",
    "test": "jest --silent",
    "test-coverage": "jest --silent --coverage",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.include=src/** --coverage.reportsDirectory=coverage-vitest",
    "test:coverage-ratchet": "npm run test:coverage && bash tests/coverage-ratchet.sh vitest coverage-vitest/coverage-summary.json",
    "check:schema-l10n": "node scripts/check-schema-l10n.js",
    "check:manifest": "node tests/validate-manifest.js",
    "test:e2e": "playwright test",
    "test:e2e:docs": "playwright test --project docs-capture",
    "stylelint": "stylelint \"{src,css}/**/*.{vue,scss,css}\"",
    "stylelint:fix": "stylelint \"{src,css}/**/*.{vue,scss,css}\" --fix",
    "format": "prettier --check \"**/*.{js,ts,vue,css,scss}\"",
    "format:fix": "prettier --write \"**/*.{js,ts,vue,css,scss}\"",
    "prepare": "git config core.hooksPath .githooks || true",
    "l10n:build": "node scripts/build-l10n-js.js",
    "check:l10n-js": "node scripts/build-l10n-js.js --check"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@conduction/nextcloud-vue": "^2.24.2",
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "^2.5.0",
    "@nextcloud/capabilities": "^1.2.1",
    "@nextcloud/dialogs": "^7.4.1",
    "@nextcloud/files": "^3.12.2",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.9.0",
    "@vueuse/core": "^14.4.0",
    "axe-core": "^4.12.1",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.2",
    "dexie": "^4.4.4",
    "dompurify": "^3.4.12",
    "gridstack": "^12.6.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "marked": "^12.0.0",
    "path-browserify": "^1.0.1",
    "pdfjs-dist": "^5.7.284",
    "pinia": "^3.0.3",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "vue": "^3.5.40",
    "vue-loader": "^17.4.2",
    "vue-material-design-icons": "^5.3.0",
    "vue-router": "^4.5.1",
    "webpack": "^5.106.2",
    "webpack-cli": "^6.0.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.25.3",
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/prettier-config": "^1.2.0",
    "@nextcloud/stylelint-config": "^2.4.0",
    "@nextcloud/webpack-vue-config": "^7.0.2",
    "@pinia/testing": "^1.0.2",
    "@playwright/test": "^1.59.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.12",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/vue3-jest": "^29.2.6",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-webpack-plugin": "^6.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-transform-stub": "^2.0.0",
    "jsdom": "^29.1.1",
    "node-polyfill-webpack-plugin": "4.0.0",
    "postcss-html": "^1.5.0",
    "prettier": "^3.9.6",
    "sass": "^1.99.0",
    "sass-loader": "^17.0.0",
    "stylelint": "^15.11.0",
    "stylelint-config-recommended-scss": "^13.1.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-webpack-plugin": "^5.0.1",
    "ts-jest": "^29.2.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.3.0"
  },
  "overrides": {
    "sha.js": "^2.4.12",
    "cipher-base": "^1.0.7",
    "elliptic": "^6.6.1",
    "pbkdf2": "^3.1.5",
    "terser-webpack-plugin": "^5.6.1",
    "cross-spawn": "^7.0.6",
    "body-parser": "^1.20.4",
    "express": "^4.22.1",
    "path-to-regexp": "^0.1.13",
    "node-forge": "^1.4.0",
    "http-proxy-middleware": "^2.0.9",
    "node-gettext": "^3.0.1",
    "lodash": "^4.18.1",
    "immutable": "^4.3.8",
    "flatted": "^3.4.2",
    "js-beautify": {
      "glob": "^10.5.0",
      "minimatch": "^9.0.7"
    },
    "webdav": {
      "minimatch": "^9.0.7"
    },
    "editorconfig": {
      "minimatch": "^9.0.7"
    },
    "filelist": {
      "minimatch": "^5.1.9"
    },
    "jest-util": {
      "picomatch": "^2.3.2"
    },
    "micromatch": {
      "picomatch": "^2.3.2"
    },
    "anymatch": {
      "picomatch": "^2.3.2"
    },
    "readdirp": {
      "picomatch": "^2.3.2"
    },
    "brace-expansion@1": "^1.1.18",
    "vite": "^7.3.6"
  },
  "prettier": "@nextcloud/prettier-config"
}
