    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-transform-stub": "^2.0.0",
    "stylelint-webpack-plugin": "^5.0.1",
    "ts-jest": "^29.2.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "vue-jest": "^3.0.7"
