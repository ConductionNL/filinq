    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.9.0",
    "@vueuse/core": "^14.4.0",
    "axe-core": "^4.12.1",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.2",
    "dexie": "^4.4.4",
    "dompurify": "^3.4.12",
    "gridstack": "^12.6.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "marked": "^12.0.0",
    "path-browserify": "^1.0.1",
    "pdfjs-dist": "^5.7.284",
    "pinia": "^3.0.3",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
