# NOTE: prettier 3 reads `.gitignore` as an ignore path too, so anything already
# gitignored (js/, coverage/, phpmetrics/) is excluded even without an entry
# here. The entries below are kept explicit anyway — an ignore that depends on
# another file's contents is one refactor away from silently switching off.

# Build output, vendored trees and the separate Docusaurus site.
js/
dist/
build/
node_modules/
vendor/
coverage/
coverage-frontend/
coverage-vitest/
docs/
*.min.*

# phpmetrics report output. Gitignored, yet 41 files of it are tracked (a
# gitignore-then-commit leftover), and it vendors third-party CSS — normalize,
# milligram, roboto — that must keep upstream's formatting.
phpmetrics/

# Generated by the translation workflow — `l10n/*.js` is emitted by the
# Nextcloud l10n tooling (`OC.L10N.register(...)`, four-space indent). This one
# is NOT gitignored, so this entry is load-bearing: without it prettier and the
# translation sync would rewrite the same files in opposite directions.
l10n/
