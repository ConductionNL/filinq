                    "author": {
                        "description": "Auteur van het document",
                        "type": "string",
                        "visible": true,
                        "order": 9,
                        "facetable": true,
                        "title": "Auteur",
                        "maxLength": 200
                    },
                    "language": {
                        "description": "Taal van het document (ISO 639-1 code)",
                        "type": "string",
                        "visible": true,
                        "order": 10,
                        "facetable": true,
                        "title": "Taal",
                        "maxLength": 2,
                        "example": "nl"
                    },
                    "keywords": {
                        "description": "Trefwoorden voor het document",
                        "type": "array",
                        "visible": true,
                        "order": 11,
                        "facetable": true,
                        "title": "Trefwoorden",
                        "items": {
                            "type": "string",
                            "maxLength": 100
                        }
                    },
                    "topic": {
                        "description": "Onderwerp/classificatie van het document",
                        "type": "string",
                        "visible": true,
                        "order": 12,
                        "facetable": true,
                        "title": "Onderwerp",
                        "maxLength": 200,
                        "example": "legal"
