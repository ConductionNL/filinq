                            "draft",
                            "pending_consent",
                            "consent_received",
                            "objection_received",
                            "anonymized",
                            "published",
                            "rejected"
                        ],
                        "default": "draft"
                    },
                    "anonymizationId": {
                        "description": "Verwijzing naar anonymisatie resultaat",
                        "type": "string",
                        "visible": false,
                        "order": 14,
                        "facetable": false,
                        "title": "Anonymisatie ID",
