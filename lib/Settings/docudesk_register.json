            "document": {
                "uri": null,
                "slug": "document",
                "title": "Document",
                "description": "Schema voor documenten opgeslagen in OpenRegister. Bevat metadata, bestandsinformatie en verwijzingen naar anonymisatie en metadata resultaten.",
                "version": "1.0.0",
                "summary": "",
