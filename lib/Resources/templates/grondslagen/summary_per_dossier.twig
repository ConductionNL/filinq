<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="utf-8">
<title>Grondslagen overzicht — {{ dossierName|default('Dossier') }}</title>
<style>
body { font-family: "DejaVu Sans", sans-serif; font-size: 11px; color: #222; margin: 0; padding: 0; }
h1 { font-size: 15px; color: #1a3c6e; border-bottom: 2px solid #1a3c6e; padding-bottom: 4px; margin-bottom: 8px; }
h2 { font-size: 12px; color: #2c5f9e; margin-top: 14px; margin-bottom: 4px; }
table { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
th { background-color: #1a3c6e; color: #fff; text-align: left; padding: 4px 6px; font-size: 10px; }
td { padding: 3px 6px; border-bottom: 1px solid #dde3ef; font-size: 10px; }
tr:nth-child(even) td { background-color: #f4f6fb; }
.meta-table td { border-bottom: none; }
.meta-label { font-weight: bold; width: 35%; color: #444; }
.footer { margin-top: 16px; font-size: 10px; color: #666; border-top: 1px solid #ccd3e0; padding-top: 6px; }
.empty-note { font-style: italic; color: #888; font-size: 10px; }
</style>
</head>
<body>

<h1>Grondslagen overzicht per dossier</h1>

<h2>Dossiergegevens</h2>
<table class="meta-table">
  <tr>
    <td class="meta-label">Naam</td>
    <td>{{ dossierName|default('—') }}</td>
  </tr>
  <tr>
    <td class="meta-label">Omschrijving</td>
    <td>{{ dossierDescription|default('—') }}</td>
  </tr>
  <tr>
    <td class="meta-label">Beoordeeld op</td>
    <td>{{ checkedOn|default('—') }}</td>
  </tr>
  <tr>
    <td class="meta-label">Overzicht gegenereerd op</td>
    <td>{{ generatedAt|default('—') }}</td>
  </tr>
</table>

<h2>Per document</h2>
{% if documents is not empty %}
<table>
  <thead>
    <tr>
      <th>Bestandsnaam</th>
      <th>Entiteiten</th>
      <th>Grondslagen (aantal)</th>
    </tr>
  </thead>
  <tbody>
    {% for doc in documents %}
    <tr>
      <td>{{ doc.fileName|default('—') }}</td>
      <td>{{ doc.entityCount|default(0) }}</td>
      <td>
        {% if doc.bases is not empty %}
          {% for baseName, count in doc.bases %}{{ baseName }} ({{ count }}){% if not loop.last %}, {% endif %}{% endfor %}
        {% else %}
          <span style="color:#888">—</span>
        {% endif %}
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<p class="empty-note">Geen geanonimiseerde documenten gevonden in dit dossier.</p>
{% endif %}

<h2>Per grondslag</h2>
{% if perGrondslag is not empty %}
<table>
  <thead>
    <tr>
      <th>Grondslag</th>
      <th>Aantal bestanden</th>
      <th>Totaal entiteiten</th>
    </tr>
  </thead>
  <tbody>
    {% for row in perGrondslag %}
    <tr>
      <td>{{ row.name|default('—') }}</td>
      <td>{{ row.fileCount|default(0) }}</td>
      <td>{{ row.entityCount|default(0) }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<p class="empty-note">Geen grondslagen geregistreerd in dit dossier.</p>
{% endif %}

<div class="footer">
  Totaal geanonimiseerde entiteiten: <strong>{{ totalEntities|default(0) }}</strong>
  &nbsp;|&nbsp;
  Unieke grondslagen: <strong>{{ totalBases|default(0) }}</strong>
  &nbsp;|&nbsp;
  Gegenereerd door DocuDesk
</div>

</body>
</html>
