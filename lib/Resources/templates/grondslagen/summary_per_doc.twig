<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="utf-8">
<title>Grondslagen samenvatting — {{ fileName|default('') }}</title>
<style>
body { font-family: "DejaVu Sans", sans-serif; font-size: 11px; color: #222; margin: 0; padding: 0; }
h1 { font-size: 15px; color: #1a3c6e; border-bottom: 2px solid #1a3c6e; padding-bottom: 4px; margin-bottom: 8px; }
h2 { font-size: 12px; color: #2c5f9e; margin-top: 14px; margin-bottom: 4px; }
table { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
th { background-color: #1a3c6e; color: #fff; text-align: left; padding: 4px 6px; font-size: 10px; }
td { padding: 3px 6px; border-bottom: 1px solid #dde3ef; font-size: 10px; }
tr:nth-child(even) td { background-color: #f4f6fb; }
.meta-table td { border-bottom: none; }
.meta-label { font-weight: bold; width: 35%; color: #444; }
.footer { margin-top: 16px; font-size: 10px; color: #666; border-top: 1px solid #ccd3e0; padding-top: 6px; }
.empty-note { font-style: italic; color: #888; font-size: 10px; }
</style>
</head>
<body>

<h1>Grondslagen samenvatting per document</h1>

<h2>Documentgegevens</h2>
<table class="meta-table">
  <tr>
    <td class="meta-label">Bestandsnaam</td>
    <td>{{ fileName|default('—') }}</td>
  </tr>
  <tr>
    <td class="meta-label">Geanonimiseerd op</td>
    <td>{{ anonymisedAt|default('—') }}</td>
  </tr>
  <tr>
    <td class="meta-label">Operator</td>
    <td>{{ operator|default('—') }}</td>
  </tr>
  <tr>
    <td class="meta-label">Tool</td>
    <td>{{ toolName|default('OpenAnonymiser via OpenRegister') }}</td>
  </tr>
</table>

<h2>Geanonimiseerde entiteiten</h2>
{% if entities is not empty %}
<table>
  <thead>
    <tr>
      <th>Entiteit</th>
      <th>Type</th>
      <th>Vervangende waarde</th>
      <th>Grondslag(en)</th>
    </tr>
  </thead>
  <tbody>
    {% for entity in entities %}
    <tr>
      <td>{{ entity.entityText|default('—') }}</td>
      <td>{{ entity.entityType|default('—') }}</td>
      <td>{{ entity.anonymizedValue|default('—') }}</td>
      <td>{{ entity.baseLabels|join(', ')|default('⟨geen grondslag vastgelegd⟩') }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<p class="empty-note">Geen geanonimiseerde entiteiten gevonden voor dit document.</p>
{% endif %}

<div class="footer">
  Totaal geanonimiseerde entiteiten: <strong>{{ entityCount|default(0) }}</strong>
  &nbsp;|&nbsp;
  Aantal unieke grondslagen: <strong>{{ distinctBasesCount|default(0) }}</strong>
  &nbsp;|&nbsp;
  Gegenereerd door DocuDesk (OpenAnonymiser via OpenRegister)
</div>

</body>
</html>
