<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        body { font-family: DejaVuSans, Arial, sans-serif; font-size: 10pt; margin: 0; padding: 20px; }
        .divider { border-top: 2px solid #666; border-bottom: 2px solid #666; padding: 16px 0; margin: 40px 0; text-align: center; }
        .divider-title { font-size: 12pt; font-weight: bold; margin-bottom: 6px; }
        .divider-meta { color: #555; font-size: 9pt; }
        .divider-notice { color: #900; font-style: italic; margin-top: 6px; }
    </style>
</head>
<body>
    <div class="divider">
        <div class="divider-title">Bijlage {{ index }}: {{ filename }}</div>
        <div class="divider-meta">{{ mimeType }} &mdash; {{ size }} bytes</div>
        {% if notice %}
        <div class="divider-notice">{{ notice }}</div>
        {% endif %}
    </div>
</body>
</html>
